# ====================================================================
#  macOS Brewfile (Infrastructure as Code)
# ====================================================================

# --------------------------------------------------------------------
# 1. CLI Tools (The 'brew' commands)
# --------------------------------------------------------------------
# Core System
brew "git"
brew "wget"
brew "curl"

# Terminal Workspace
brew "neovim"
brew "tmux"
brew "ripgrep" # Nvim Telescope 必备的极速搜索
brew "fd"      # Nvim 必备的极速文件查找

# Development & Runtimes
brew "nvm"     # Node.js 环境管理器 (coc.nvim 依赖)
brew "ollama"  # 本地大模型运行环境

# Network & Proxy
brew "xray"    # 核心网络代理引擎

# --------------------------------------------------------------------
# 2. GUI Applications (The 'cask' commands)
# --------------------------------------------------------------------
# Development & IDE
cask "visual-studio-code"
cask "docker"

# Network & Proxy Clients
cask "clash-verge-rev"
cask "tailscale"

# Knowledge Management & Productivity
cask "obsidian"
cask "utools"

# macOS Utilities
cask "appcleaner"

# --------------------------------------------------------------------
# 3. Fonts (New Syntax)
# --------------------------------------------------------------------
# 终端与代码极客必备的 Nerd Font (自动包含所有图标)
cask "font-hack-nerd-font"



