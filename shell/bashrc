# --- Interactive Shell Initialization ---

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# --- History Settings ---
HISTSIZE=1000
HISTCONTROL=ignoredups
# Append to the history file, don't overwrite it
shopt -s histappend

# Cross-Distribution Bash Completion Detection
if ! shopt -oq posix; then
    # Ubuntu / Debian
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    # CentOS / RHEL
    elif [ -f /etc/profile.d/bash_completion.sh ]; then
        . /etc/profile.d/bash_completion.sh
    fi
fi

# --- Load Common Aliases ---
if [ -f "${HOME}/.aliases" ]; then
    . "${HOME}/.aliases"
fi

# --- Load Local Secrets (Not in Git) ---
# Use this for private tokens or machine-specific exports
if [ -f "${HOME}/.localrc" ]; then
    . "${HOME}/.localrc"
fi

# --- Set Default Editor ---
export EDITOR="vim"
export LANG="en_US.UTF-8"

# --- Custom Prompt (Optional) ---
# PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# --- NVM (Node Version Manager) ---
export NVM_DIR="$HOME/.nvm"
if [ -d "${NVM_DIR}" ]; then
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

    # Optional: Auto-use the default version quietly
    # nvm use default > /dev/null
fi

# --- PATH SETTINGS ---
# Add local bin to PATH for user-installed binaries
if [ -d "${HOME}/.local/bin" ]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi

# --- DEV MODE DETECTION ---
# A small visual reminder if you are in Dev Mode (where coc.nvim is active)
if [ -f "${HOME}/.vim_dev_mode" ]; then
    echo -e "\033[1;33m[Dev Mode Active]\033[0m Node $(node -v) is ready for Vim LSP."
fi



