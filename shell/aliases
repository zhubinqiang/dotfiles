scpid() {
    local f="."
    if [ "$#" -ne "0" ]; then
        f="${1}"
        if [ ! -e "${f}" ]; then
            echo "${f} is not found"
            return 128
        fi
    fi

    if ( echo ${f} | grep -q ' ' ); then
        local containSpace=true
    fi

    local rp="$(realpath "${f}")"
    # local rp="$(dirname "${f}")/$(basename "${f}")"
    rp="$(echo ${rp} | sed 's/ /\\ /g')"

    if [ ${containSpace} ]; then
        local h="$(whoami)@$(hostname):\"${rp}\""
        echo "${h}"
        for i in $(seq ${#h}); do
            echo -n '*'
        done
        echo ""
        for i in $(ip addr | grep -w 'inet' | grep -v '127.0.0.1' | sed -e 's/.*inet //' -e 's/\/.*$//g'); do
            echo "$(whoami)@${i}:\"${rp}\""
        done
        for i in $(seq ${#h}); do
            echo -n '*'
        done
    else
        local h="$(whoami)@$(hostname):${rp}"
        echo "${h}"
        for i in $(seq ${#h}); do
            echo -n '*'
        done
        echo ""
        for i in $(ip addr | grep -w 'inet' | grep -v '127.0.0.1' | sed -e 's/.*inet //' -e 's/\/.*$//g'); do
            echo "$(whoami)@${i}:${rp}"
        done
        for i in $(seq ${#h}); do
            echo -n '*'
        done
    fi
    echo ""
    echo "${rp}"
}


