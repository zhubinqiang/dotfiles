function docker-enter() {
    if ( docker exec -dt $1 /bin/bash &> /dev/null ); then
        docker exec -it $1 /bin/bash
    else
        docker exec -it $1 sh
    fi
}

function docker-image-history() {
    docker history --no-trunc "$1" | sed 1d | tac | tr -s ' ' | sed 's/^.*#(nop) //' | sed 's,^.* /bin/sh -c ,RUN ,g' | awk '{$NF="";print}' | awk '{$NF="";print}' |  sed 's/\s$//' | sed 's,&& ,&\\\n    ,g'
}

