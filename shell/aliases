git-init() {
    local cwd=$(cd $(dirname .); pwd)
    if [ $# -ne "0" ]; then
        local d=$1
        mkdir -p ${d}
        cd ${d}
    fi
    git init .
    chmod 755 -R .git/refs/
    chmod 755 -R .git/objects/
    git config receive.denyCurrentBranch ignore

    cd ${cwd}
}

