# ====================================================================
# 操作系统特有文件 (OS Specific)
# ====================================================================
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ====================================================================
# 隐私与安全 (Security & Secrets) - 绝对不要同步！
# ====================================================================
# SSH 私钥
.ssh/id_rsa
.ssh/id_ed25519
.ssh/*.pem
.ssh/known_hosts

# 包含敏感 Token 的本地配置文件 (建议改用 .local 后缀)
*.local
*.secret
.env
.netrc

# npm 秘钥文件
.npmrc_local

# ====================================================================
# 应用程序缓存与垃圾文件 (App Caches & Junk)
# ====================================================================
.cache/
.npm/_cacache/
.vscode/.history/
.idea/
*.log
*.tmp
*.swp
*.swo

# ====================================================================
# 特殊处理：允许同步的文件
# ====================================================================
# 虽然通常忽略 .env，但如果你有示例模版，可以手动取消忽略
# !.env.example

## nvim, doesn't need to track this file
/bin/nvim-linux-x86_64.tar.gz


